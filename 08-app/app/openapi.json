{
  "openapi": "3.1.0",
  "info": {
    "title": "The Soft Life System API",
    "version": "1.0.0",
    "description": "Public and admin API for The Soft Life System. Member endpoints use a bearer token from /api/signin. Admin endpoints use a separate super-admin bearer token from /api/admin/login. The purchase webhook uses a separate bearer secret.",
    "contact": {
      "name": "Gabochie Books",
      "email": "admin@gabochie.com",
      "url": "https://soft.gabochie.com"
    },
    "license": {
      "name": "Proprietary"
    }
  },
  "servers": [
    {
      "url": "https://soft.gabochie.com",
      "description": "Production"
    }
  ],
  "tags": [
    {
      "name": "Public",
      "description": "Health, configuration and discovery."
    },
    {
      "name": "Auth",
      "description": "Member signup, signin and sessions."
    },
    {
      "name": "Member",
      "description": "Authenticated member features."
    },
    {
      "name": "Audio",
      "description": "Authenticated audio streaming."
    },
    {
      "name": "Admin",
      "description": "Super-admin operations. Requires an admin bearer token."
    },
    {
      "name": "Webhook",
      "description": "Checkout provider callbacks. Requires the webhook bearer secret."
    }
  ],
  "paths": {
    "/api/health": {
      "get": {
        "tags": [
          "Public"
        ],
        "summary": "Health check",
        "responses": {
          "200": {
            "description": "Service is up"
          }
        }
      }
    },
    "/api/config": {
      "get": {
        "tags": [
          "Public"
        ],
        "summary": "Public runtime configuration",
        "responses": {
          "200": {
            "description": "Checkout URL, support email, site URL and audio tier data",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Config"
                }
              }
            }
          }
        }
      }
    },
    "/api/signup": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Create a free member account",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SignupRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Account created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponse"
                }
              }
            }
          },
          "400": {
            "description": "Validation error"
          }
        }
      }
    },
    "/api/signin": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Sign in and receive a member bearer token",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SigninRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Signed in",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponse"
                }
              }
            }
          },
          "401": {
            "description": "Invalid credentials"
          }
        }
      }
    },
    "/api/signout": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Revoke the current member session",
        "security": [
          {
            "memberAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Signed out"
          }
        }
      }
    },
    "/api/me": {
      "get": {
        "tags": [
          "Member"
        ],
        "summary": "Get the current member profile",
        "security": [
          {
            "memberAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Member profile",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          }
        }
      }
    },
    "/api/onboarding": {
      "get": {
        "tags": [
          "Member"
        ],
        "summary": "Get the member's onboarding profile",
        "security": [
          {
            "memberAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Onboarding profile or null",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OnboardingResponse"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Member"
        ],
        "summary": "Create or update onboarding, consent and acquisition data",
        "security": [
          {
            "memberAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OnboardingRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Onboarding saved",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OnboardingResponse"
                }
              }
            }
          },
          "400": {
            "description": "Validation error, including WhatsApp consent without a valid number"
          }
        }
      }
    },
    "/api/events": {
      "post": {
        "tags": [
          "Member"
        ],
        "summary": "Record an allowlisted product event",
        "security": [
          {
            "memberAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EventRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Event recorded"
          },
          "400": {
            "description": "Unknown event"
          }
        }
      }
    },
    "/api/tasks": {
      "get": {
        "tags": [
          "Member"
        ],
        "summary": "List the member's 90-day plan tasks",
        "security": [
          {
            "memberAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Task list"
          }
        }
      },
      "post": {
        "tags": [
          "Member"
        ],
        "summary": "Add a custom task",
        "security": [
          {
            "memberAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NewTask"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Task created"
          }
        }
      }
    },
    "/api/tasks/toggle": {
      "post": {
        "tags": [
          "Member"
        ],
        "summary": "Toggle a task's done state",
        "security": [
          {
            "memberAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "id"
                ],
                "properties": {
                  "id": {
                    "type": "integer"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Task updated"
          },
          "404": {
            "description": "Task not found"
          }
        }
      }
    },
    "/api/affiliate": {
      "get": {
        "tags": [
          "Member"
        ],
        "summary": "Get affiliate link stats",
        "security": [
          {
            "memberAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Referral code and commission data"
          }
        }
      }
    },
    "/api/audio/{slug}.mp3": {
      "get": {
        "tags": [
          "Audio"
        ],
        "summary": "Stream a chapter audio file",
        "description": "The free tier can stream intro and ch01. The complete tier can stream ch01–ch15. Supports HTTP Range requests.",
        "security": [
          {
            "memberAuth": []
          }
        ],
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "examples": [
                "intro",
                "ch01",
                "ch15"
              ]
            }
          },
          {
            "name": "t",
            "in": "query",
            "required": false,
            "description": "Optional member token for audio elements that cannot set headers.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Range",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Audio stream"
          },
          "206": {
            "description": "Partial audio stream"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Locked for the current tier"
          },
          "404": {
            "description": "Audio not found"
          }
        }
      }
    },
    "/api/admin/login": {
      "post": {
        "tags": [
          "Admin"
        ],
        "summary": "Create a super-admin session",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "password"
                ],
                "properties": {
                  "password": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Admin token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminAuthResponse"
                }
              }
            }
          },
          "401": {
            "description": "Wrong admin password"
          }
        }
      }
    },
    "/api/admin/logout": {
      "post": {
        "tags": [
          "Admin"
        ],
        "summary": "Revoke the current admin session",
        "security": [
          {
            "adminAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Signed out"
          }
        }
      }
    },
    "/api/admin/overview": {
      "get": {
        "tags": [
          "Admin"
        ],
        "summary": "Business overview metrics",
        "security": [
          {
            "adminAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Users, signups, tasks, referrals, purchases, revenue, onboarding, WhatsApp opt-ins, events and audio status"
          }
        }
      }
    },
    "/api/admin/users": {
      "get": {
        "tags": [
          "Admin"
        ],
        "summary": "List members",
        "security": [
          {
            "adminAuth": []
          }
        ],
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 50,
              "maximum": 100
            }
          },
          {
            "name": "offset",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Member list"
          }
        }
      }
    },
    "/api/admin/users/{id}/tier": {
      "post": {
        "tags": [
          "Admin"
        ],
        "summary": "Set a member's tier",
        "security": [
          {
            "adminAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "tier"
                ],
                "properties": {
                  "tier": {
                    "type": "string",
                    "enum": [
                      "free",
                      "complete"
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Tier updated"
          },
          "404": {
            "description": "Member not found"
          }
        }
      }
    },
    "/api/admin/users/{id}/role": {
      "post": {
        "tags": [
          "Admin"
        ],
        "summary": "Set a member's role",
        "security": [
          {
            "adminAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "role"
                ],
                "properties": {
                  "role": {
                    "type": "string",
                    "enum": [
                      "member",
                      "admin",
                      "superadmin"
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Role updated"
          },
          "404": {
            "description": "Member not found"
          }
        }
      }
    },
    "/api/admin/referrals": {
      "get": {
        "tags": [
          "Admin"
        ],
        "summary": "List recent referral events",
        "security": [
          {
            "adminAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Referral list"
          }
        }
      }
    },
    "/api/admin/purchases": {
      "get": {
        "tags": [
          "Admin"
        ],
        "summary": "List recent purchases",
        "security": [
          {
            "adminAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Purchase list"
          }
        }
      }
    },
    "/api/admin/onboarding": {
      "get": {
        "tags": [
          "Admin"
        ],
        "summary": "List onboarding profiles and WhatsApp consent",
        "security": [
          {
            "adminAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Up to 200 onboarding profiles joined to member accounts"
          }
        }
      }
    },
    "/api/admin/audio": {
      "get": {
        "tags": [
          "Admin"
        ],
        "summary": "Audio upload status",
        "security": [
          {
            "adminAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Uploaded, missing and expected chapters"
          }
        }
      }
    },
    "/api/webhooks/purchase": {
      "post": {
        "tags": [
          "Webhook"
        ],
        "summary": "Record a purchase and upgrade the matching member",
        "security": [
          {
            "webhookAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "email"
                ],
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email"
                  },
                  "order_id": {
                    "type": "string"
                  },
                  "tier": {
                    "type": "string",
                    "enum": [
                      "free",
                      "complete"
                    ],
                    "default": "complete"
                  },
                  "amount": {
                    "type": "number"
                  },
                  "currency": {
                    "type": "string"
                  },
                  "provider": {
                    "type": "string",
                    "default": "selar"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Purchase recorded or duplicate ignored"
          },
          "401": {
            "description": "Bad webhook secret"
          },
          "503": {
            "description": "Webhook not configured"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "memberAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Member token from /api/signin."
      },
      "adminAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Super-admin token from /api/admin/login."
      },
      "webhookAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Purchase webhook secret configured in Cloudflare."
      }
    },
    "schemas": {
      "Config": {
        "type": "object",
        "properties": {
          "siteUrl": {
            "type": "string",
            "format": "uri"
          },
          "checkoutUrl": {
            "type": "string"
          },
          "supportEmail": {
            "type": "string",
            "format": "email"
          },
          "freeAudio": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "allAudio": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "tiers": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "SignupRequest": {
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string",
            "minLength": 8
          },
          "name": {
            "type": "string"
          },
          "ref": {
            "type": "string"
          },
          "acquisition": {
            "$ref": "#/components/schemas/Acquisition"
          }
        }
      },
      "Acquisition": {
        "type": "object",
        "properties": {
          "source": {
            "type": "string"
          },
          "utm_source": {
            "type": "string"
          },
          "utm_medium": {
            "type": "string"
          },
          "utm_campaign": {
            "type": "string"
          },
          "utm_content": {
            "type": "string"
          },
          "utm_term": {
            "type": "string"
          },
          "referrer": {
            "type": "string"
          },
          "landing_path": {
            "type": "string"
          }
        }
      },
      "OnboardingRequest": {
        "type": "object",
        "properties": {
          "business_name": {
            "type": "string",
            "maxLength": 120
          },
          "business_stage": {
            "type": "string",
            "enum": [
              "",
              "idea",
              "early",
              "growing",
              "established",
              "other"
            ]
          },
          "country": {
            "type": "string",
            "maxLength": 80
          },
          "timezone": {
            "type": "string",
            "maxLength": 64
          },
          "main_goal": {
            "type": "string",
            "enum": [
              "",
              "simplify",
              "offer",
              "systems",
              "delegate",
              "time",
              "freedom",
              "other"
            ]
          },
          "biggest_challenge": {
            "type": "string",
            "enum": [
              "",
              "time",
              "overwhelm",
              "pricing",
              "clients",
              "systems",
              "focus",
              "other"
            ]
          },
          "revenue_range": {
            "type": "string",
            "enum": [
              "",
              "pre_revenue",
              "under_1k",
              "1k_3k",
              "3k_10k",
              "10k_plus",
              "prefer_not"
            ]
          },
          "team_size": {
            "type": "string",
            "enum": [
              "",
              "solo",
              "contractors",
              "small_team",
              "team"
            ]
          },
          "whatsapp_number": {
            "type": "string",
            "description": "Required only when whatsapp_consent is true. 7-15 digits with country code."
          },
          "whatsapp_consent": {
            "type": "boolean",
            "default": false
          },
          "marketing_consent": {
            "type": "boolean",
            "default": false
          },
          "acquisition": {
            "$ref": "#/components/schemas/Acquisition"
          }
        }
      },
      "OnboardingResponse": {
        "type": "object",
        "properties": {
          "onboarding": {
            "type": "object",
            "nullable": true,
            "properties": {
              "business_name": {
                "type": "string"
              },
              "business_stage": {
                "type": "string"
              },
              "country": {
                "type": "string"
              },
              "timezone": {
                "type": "string"
              },
              "main_goal": {
                "type": "string"
              },
              "biggest_challenge": {
                "type": "string"
              },
              "revenue_range": {
                "type": "string"
              },
              "team_size": {
                "type": "string"
              },
              "whatsapp_number": {
                "type": "string"
              },
              "whatsapp_consent": {
                "type": "integer"
              },
              "whatsapp_consent_at": {
                "type": "string",
                "nullable": true
              },
              "marketing_consent": {
                "type": "integer"
              },
              "marketing_consent_at": {
                "type": "string",
                "nullable": true
              },
              "consent_version": {
                "type": "string"
              },
              "source": {
                "type": "string"
              },
              "utm_source": {
                "type": "string"
              },
              "utm_medium": {
                "type": "string"
              },
              "utm_campaign": {
                "type": "string"
              },
              "completed_at": {
                "type": "string",
                "nullable": true
              },
              "updated_at": {
                "type": "string"
              }
            }
          }
        }
      },
      "EventRequest": {
        "type": "object",
        "required": [
          "event"
        ],
        "properties": {
          "event": {
            "type": "string",
            "enum": [
              "onboarding_skipped",
              "task_added",
              "task_completed",
              "audio_play",
              "checkout_click"
            ]
          },
          "path": {
            "type": "string"
          },
          "meta": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      "SigninRequest": {
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string"
          }
        }
      },
      "AuthResponse": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string"
          },
          "user": {
            "$ref": "#/components/schemas/User"
          }
        }
      },
      "AdminAuthResponse": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "superadmin"
            ]
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "User": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "email": {
            "type": "string",
